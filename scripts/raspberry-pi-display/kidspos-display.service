[Unit]
Description=KidsPOS e-Paper Display
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/kidspos-display
ExecStart=/usr/bin/python3 /opt/kidspos-display/app.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kidspos-display

[Install]
WantedBy=multi-user.target
